# LEARIS agent environment for EC2
# Location on EC2: /opt/sigap-project/learis/agent/.env

LEARIS_ENV=prod
LEARIS_SECRET=generate_with_manage.py_secret
LEARIS_DB=/app/data/sigap.db
LEARIS_AUTO_DELETE=1
# Optional fallback model for students who have not connected their own:
# LEARIS_AI_BASE_URL=https://api.openai.com/v1
# LEARIS_AI_MODEL=gpt-4o-mini
# LEARIS_AI_API_KEY=
# LEARIS_GITHUB_TOKEN=

# LEARIS agent environment on the server
# Location on EC2: /opt/learis/learis/agent/.env  (docker-compose.yml reads it; never commit it)

LEARIS_ENV=prod
LEARIS_SECRET=generate_with_manage.py_secret
LEARIS_AUTO_DELETE=1
# LEARIS_DB is set by docker-compose.yml (/app/data/learis.db, in the learis_agent_data volume)

# A model for everyone who has not connected their own (optional). Amazon Bedrock with an API key:
# AWS_BEARER_TOKEN_BEDROCK=
# LEARIS_BEDROCK_REGION=ap-southeast-2
# …or any OpenAI-compatible endpoint:
# LEARIS_AI_BASE_URL=https://api.openai.com/v1
# LEARIS_AI_MODEL=gpt-4o-mini
# LEARIS_AI_API_KEY=
# LEARIS_GITHUB_TOKEN=

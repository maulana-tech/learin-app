# LEARIS agent service. Copy to .env; a real environment variable beats this file.

# dev | staging | prod
LEARIS_ENV=dev

# Signs session tokens. Generate one with: python3 manage.py secret
LEARIS_SECRET=

# SQLite file: the students' documents, evidence, plans and runs.
LEARIS_DB=data/learis.db

# Delete a document's full text once analysed, keeping only the quoted evidence.
# 1 (default) or 0. Each student can change it for themselves.
LEARIS_AUTO_DELETE=1

# ------------------------------------------------------------- AI (optional)
# Students bring their own model from the AI & privacy page; nothing here is
# needed for that. Set these only to give the deployment a fallback model,
# used when a student has not connected one. Any OpenAI-compatible endpoint.
# LEARIS_AI_BASE_URL=https://api.openai.com/v1
# LEARIS_AI_MODEL=gpt-4o-mini
# LEARIS_AI_API_KEY=          # better kept in .secrets/ai.env
# LEARIS_AI_TIMEOUT=90

# Let a student's base URL point at a private or local address (Ollama, LM
# Studio). On by default in dev, off in prod.
# LEARIS_ALLOW_LOCAL_AI=1

# Let agents pick their own tools (function calling) with the server's model. 1 or 0.
# LEARIS_AI_TOOLS=1

# Threads that run the agent team, so several students can run at once.
# LEARIS_WORKERS=3

# Scheduled jobs (stale runs, auto-delete sweep, weekly check-in). 0 turns them off.
# LEARIS_SCHEDULE=1

# GitHub's API allows 60 unauthenticated requests an hour; a token raises that.
# LEARIS_GITHUB_TOKEN=

# Where the service listens. A platform-set PORT opens the bind to 0.0.0.0.
# PORT=8787
# LEARIS_HOST=127.0.0.1
